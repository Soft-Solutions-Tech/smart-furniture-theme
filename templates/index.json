        "liquid": "<!-- BNPL calculator -->\n<style>\n  .bnpl-calc {\n    /* Smart Furniture palette */\n    --bnpl-navy: #002659;\n    --bnpl-slate: #79858d;\n    --bnpl-coral: #ee7857;\n\n    /* Neutrals */\n    --bnpl-ink: #16181d;\n    --bnpl-muted: #a8adb3;\n    --bnpl-line: #e4e6e9;\n    --bnpl-panel: #ece7e1;\n\n    /* Type */\n    --bnpl-font: var(--text-font-family);\n    --bnpl-heading-font: var(--heading-font-family);\n\n    position: relative;\n    margin: 0;\n    padding: 0;\n    overflow: hidden;\n    background: #fff;\n    color: var(--bnpl-ink);\n    font-family: var(--bnpl-font);\n  }\n\n  .bnpl-calc__inner {\n    position: relative;\n    z-index: 1;\n    display: grid;\n    grid-template-columns: 1.1fr minmax(0, 340px);\n    align-items: start;\n    gap: clamp(32px, 5vw, 72px);\n    max-width: 1200px;\n    margin-inline: auto;\n    padding-inline: clamp(20px, 4vw, 48px);\n    padding-block: clamp(40px, 6vw, 80px);\n    box-sizing: border-box;\n  }\n\n  /* Left column */\n  .bnpl-calc__title {\n    margin: 0 0 14px;\n    font-family: var(--bnpl-heading-font);\n    font-size: clamp(34px, 4.6vw, 56px);\n    font-weight: 700;\n    line-height: 1.02;\n    letter-spacing: -0.03em;\n    color: var(--bnpl-navy);\n  }\n\n  .bnpl-calc__subtitle {\n    max-width: 620px;\n    margin: 0 0 30px;\n    font-size: 16px;\n    line-height: 1.6;\n    color: var(--bnpl-slate);\n  }\n\n  /* Provider pills - equal grid so every provider aligns cleanly */\n  .bnpl-calc__providers {\n    display: grid;\n    grid-template-columns: repeat(5, minmax(0, 1fr));\n    gap: 12px;\n    margin-bottom: 30px;\n  }\n\n  .bnpl-calc__pill {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 100%;\n    min-width: 0;\n    min-height: 48px;\n    padding: 10px 12px;\n    border: 1.5px solid var(--bnpl-ink);\n    border-radius: 999px;\n    background: #fff;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 500;\n    line-height: 1;\n    color: var(--bnpl-ink);\n    cursor: pointer;\n    transition:\n      border-color 0.2s ease,\n      color 0.2s ease,\n      background-color 0.2s ease;\n  }\n\n  .bnpl-calc__pill-logo {\n    display: block;\n    width: auto;\n    height: 24px;\n    max-width: 86px;\n    object-fit: contain;\n  }\n\n  .bnpl-calc__pill:hover {\n    background: #fafafa;\n  }\n\n  .bnpl-calc__pill[aria-pressed=\"true\"] {\n    border-color: var(--bnpl-coral);\n    color: var(--bnpl-coral);\n  }\n\n  .bnpl-calc__pill:focus-visible {\n    outline: 2px solid var(--bnpl-coral);\n    outline-offset: 3px;\n  }\n\n  /* Browse link */\n  .bnpl-calc__browse {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 10px;\n    padding: 13px 22px;\n    border: 1.5px solid var(--bnpl-ink);\n    border-radius: 999px;\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 500;\n    line-height: 1;\n    color: var(--bnpl-ink);\n    text-decoration: none;\n    transition:\n      background-color 0.2s ease,\n      color 0.2s ease;\n  }\n\n  .bnpl-calc__browse:hover {\n    background: var(--bnpl-ink);\n    color: #fff;\n  }\n\n  .bnpl-calc__browse:focus-visible {\n    outline: 2px solid var(--bnpl-ink);\n    outline-offset: 3px;\n  }\n\n  .bnpl-calc__browse svg {\n    width: 13px;\n    height: 13px;\n    flex-shrink: 0;\n  }\n\n  /* Right column */\n  .bnpl-calc__card {\n    padding: clamp(22px, 2.2vw, 28px);\n    border-radius: 18px;\n    background: #fff;\n    box-shadow: 0 12px 48px rgba(22, 24, 29, 0.1);\n    box-sizing: border-box;\n  }\n\n  .bnpl-calc__card-title {\n    margin: 0 0 24px;\n    font-family: var(--bnpl-heading-font);\n    font-size: 16px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n    color: var(--bnpl-navy);\n  }\n\n  .bnpl-calc__label {\n    display: block;\n    margin-bottom: 8px;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--bnpl-muted);\n  }\n\n  .bnpl-calc__field {\n    width: 100%;\n    padding: 14px 16px;\n    margin-bottom: 20px;\n    border: 1px solid var(--bnpl-line);\n    border-radius: 10px;\n    background: #fff;\n    font-family: inherit;\n    font-size: 15px;\n    font-weight: 500;\n    color: var(--bnpl-ink);\n    box-sizing: border-box;\n    transition: border-color 0.2s ease;\n  }\n\n  .bnpl-calc__field:focus-visible {\n    outline: none;\n    border-color: var(--bnpl-coral);\n  }\n\n  .bnpl-calc__field[type=\"number\"] {\n    appearance: textfield;\n    -moz-appearance: textfield;\n  }\n\n  .bnpl-calc__field::-webkit-outer-spin-button,\n  .bnpl-calc__field::-webkit-inner-spin-button {\n    -webkit-appearance: none;\n    margin: 0;\n  }\n\n  select.bnpl-calc__field {\n    appearance: none;\n    -webkit-appearance: none;\n    padding-right: 40px;\n    background-image: url(\"data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8' fill='none' stroke='%23a8adb3' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpolyline points='1,2 6,6.5 11,2'/%3E%3C/svg%3E\");\n    background-repeat: no-repeat;\n    background-position: right 16px center;\n    background-size: 10px;\n    cursor: pointer;\n  }\n\n  .bnpl-calc[dir=\"rtl\"] select.bnpl-calc__field {\n    padding-right: 16px;\n    padding-left: 40px;\n    background-position: left 16px center;\n  }\n\n  /* Monthly payment */\n  .bnpl-calc__payment {\n    padding: 18px 20px;\n    border-radius: 12px;\n    background: var(--bnpl-panel);\n  }\n\n  .bnpl-calc__payment-label {\n    display: block;\n    margin-bottom: 8px;\n    font-size: 10px;\n    font-weight: 600;\n    letter-spacing: 0.1em;\n    text-transform: uppercase;\n    color: var(--bnpl-slate);\n  }\n\n  .bnpl-calc__amount {\n    font-size: clamp(30px, 3vw, 36px);\n    font-weight: 500;\n    line-height: 1.05;\n    letter-spacing: -0.02em;\n    color: var(--bnpl-coral);\n    font-variant-numeric: tabular-nums;\n  }\n\n  .bnpl-calc__unit {\n    margin-top: 6px;\n    font-size: 12px;\n    color: var(--bnpl-slate);\n  }\n\n  @media screen and (max-width: 1100px) {\n    .bnpl-calc__providers {\n      grid-template-columns: repeat(4, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 989px) {\n    .bnpl-calc__inner {\n      grid-template-columns: 1fr;\n      gap: 40px;\n    }\n\n    .bnpl-calc__card {\n      max-width: 420px;\n    }\n  }\n\n  @media screen and (max-width: 749px) {\n    .bnpl-calc__providers {\n      grid-template-columns: repeat(3, minmax(0, 1fr));\n    }\n  }\n\n  @media screen and (max-width: 479px) {\n    .bnpl-calc__providers {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n\n    .bnpl-calc__pill {\n      width: 100%;\n      padding-inline: 10px;\n    }\n\n    .bnpl-calc__browse,\n    .bnpl-calc__card {\n      width: 100%;\n      box-sizing: border-box;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .bnpl-calc__pill,\n    .bnpl-calc__browse,\n    .bnpl-calc__field {\n      transition: none;\n    }\n  }\n</style>\n\n<section\n  class=\"bnpl-calc\"\n  id=\"bnpl-calc\"\n  aria-labelledby=\"bnpl-calc-title\"\n>\n  <div class=\"bnpl-calc__inner\">\n\n    <!-- Left -->\n    <div>\n      <h2\n        class=\"bnpl-calc__title\"\n        id=\"bnpl-calc-title\"\n        data-bnpl-title\n      >\n        Buy now pay later\n      </h2>\n\n      <p\n        class=\"bnpl-calc__subtitle\"\n        data-bnpl-subtitle\n      >\n        Furnish your home your way, with multiple installment systems up to 61 months.\n      </p>\n\n      <div\n        class=\"bnpl-calc__providers\"\n        role=\"group\"\n        aria-label=\"Choose a provider\"\n        data-bnpl-providers\n      ></div>\n    </div>\n\n    <!-- Right -->\n    <div class=\"bnpl-calc__card\">\n      <h3\n        class=\"bnpl-calc__card-title\"\n        data-bnpl-card-title\n      >\n        Installment Calculator\n      </h3>\n\n      <label\n        class=\"bnpl-calc__label\"\n        for=\"bnpl-calc-price\"\n        data-bnpl-price-label\n      >\n        Product price (EGP)\n      </label>\n\n      <input\n        class=\"bnpl-calc__field\"\n        id=\"bnpl-calc-price\"\n        type=\"number\"\n        min=\"0\"\n        step=\"100\"\n        value=\"50000\"\n        inputmode=\"numeric\"\n        data-bnpl-price\n      />\n\n      <label\n        class=\"bnpl-calc__label\"\n        for=\"bnpl-calc-duration\"\n        data-bnpl-duration-label\n      >\n        Duration\n      </label>\n\n      <select\n        class=\"bnpl-calc__field\"\n        id=\"bnpl-calc-duration\"\n        data-bnpl-duration\n      ></select>\n\n      <div class=\"bnpl-calc__payment\">\n        <span\n          class=\"bnpl-calc__payment-label\"\n          data-bnpl-payment-label\n        >\n          Monthly payment\n        </span>\n\n        <div\n          class=\"bnpl-calc__amount\"\n          data-bnpl-amount\n          aria-live=\"polite\"\n        >\n          0\n        </div>\n\n        <div\n          class=\"bnpl-calc__unit\"\n          data-bnpl-unit\n        >\n          EGP / month\n        </div>\n      </div>\n    </div>\n\n  </div>\n</section>\n\n<script>\n  (function () {\n\n    var PROVIDERS = [\n      {\n        name: \"NBE\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/NBE.png?v=1790784328\",\n        plans: [\n          { months: 6, interest: 8.25 },\n          { months: 9, interest: 11.25 },\n          { months: 12, interest: 14.25 },\n          { months: 18, interest: 19.75 },\n          { months: 24, interest: 24.75 },\n          { months: 36, interest: 33.50 }\n        ]\n      },\n      {\n        name: \"Banque Misr\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/Banque_Misr.png?v=1790784345\",\n        plans: [\n          { months: 3, interest: 9.25 },\n          { months: 6, interest: 12.25 },\n          { months: 12, interest: 18.25 },\n          { months: 18, interest: 24.25 },\n          { months: 24, interest: 29.25 },\n          { months: 36, interest: 38.25 }\n        ]\n      },\n      {\n        name: \"Emirates NBD\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/Emirates_NBD.png?v=1790784349\",\n        plans: [\n          { months: 6, interest: 7.50 },\n          { months: 12, interest: 13.00 },\n          { months: 18, interest: 17.00 },\n          { months: 24, interest: 22.50 }\n        ]\n      },\n      {\n        name: \"NBK\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/NBK.webp?v=1790784377\",\n        plans: [\n          { months: 6, interest: 8.50 },\n          { months: 12, interest: 13.50 },\n          { months: 18, interest: 18.50 },\n          { months: 24, interest: 22.50 }\n        ]\n      },\n      {\n        name: \"المشرق\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/Mashreq.jpg?v=1790784317\",\n        plans: [\n          { months: 3, interest: 13.00 },\n          { months: 6, interest: 16.50 },\n          { months: 9, interest: 20.50 },\n          { months: 12, interest: 23.00 }\n        ]\n      },\n      {\n        name: \"ADIB\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/ADIB.png?v=1790784294\",\n        plans: [\n          { months: 3, interest: 5.50 },\n          { months: 6, interest: 7.00 },\n          { months: 9, interest: 11.00 },\n          { months: 12, interest: 12.00 },\n          { months: 18, interest: 18.50 },\n          { months: 24, interest: 23.50 },\n          { months: 36, interest: 32.00 }\n        ]\n      },\n      {\n        name: \"KFH\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/KFH.png?v=1790784309\",\n        plans: [\n          { months: 3, interest: 5.00 },\n          { months: 6, interest: 8.00 },\n          { months: 9, interest: 11.00 },\n          { months: 12, interest: 14.00 },\n          { months: 18, interest: 19.50 },\n          { months: 24, interest: 25.50 }\n        ]\n      },\n      {\n        name: \"Bank NXT\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/Bank_NXT.png?v=1790784340\",\n        plans: [\n          { months: 3, interest: 4.00 },\n          { months: 6, interest: 7.50 },\n          { months: 12, interest: 14.00 },\n          { months: 18, interest: 18.50 },\n          { months: 24, interest: 23.00 },\n          { months: 36, interest: 31.50 }\n        ]\n      },\n      {\n        name: \"SAIB\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/SAIB.png?v=1790784371\",\n        plans: [\n          { months: 3, interest: 5.75 },\n          { months: 6, interest: 9.00 },\n          { months: 12, interest: 16.00 },\n          { months: 18, interest: 23.00 }\n        ]\n      },\n      {\n        name: \"التجاري وفا بنك\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/495978b926fd947dd85a470f90637cdb.png?v=1790784367\",\n        plans: [\n          { months: 6, interest: 7.50 },\n          { months: 12, interest: 14.50 },\n          { months: 18, interest: 22.50 },\n          { months: 24, interest: 29.50 }\n        ]\n      },\n      {\n        name: \"FAB Misr\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/FAB.webp?v=1790784353\",\n        plans: [\n          { months: 6, interest: 10.50 },\n          { months: 12, interest: 18.00 },\n          { months: 18, interest: 25.75 },\n          { months: 24, interest: 34.00 },\n          { months: 36, interest: 44.25 }\n        ]\n      },\n      {\n        name: \"alBaraka Bank\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/Al_Baraka.webp?v=1790784303\",\n        plans: [\n          { months: 3, interest: 5.00 },\n          { months: 6, interest: 7.00 },\n          { months: 9, interest: 10.00 },\n          { months: 12, interest: 12.50 },\n          { months: 18, interest: 18.00 },\n          { months: 24, interest: 22.50 },\n          { months: 36, interest: 32.00 }\n        ]\n      },\n      {\n        name: \"ValU\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/value_logo_2025.png?v=1790781621\",\n        maxMonths: 60,\n        plans: [{ months: 60, interest: 0 }]\n      },\n      {\n        name: \"Aman\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/amaneg.png?v=1790782104\",\n        maxMonths: 24,\n        plans: [{ months: 24, interest: 0 }]\n      },\n      {\n        name: \"Halan\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/halan-v2.png?v=1790781932\",\n        maxMonths: 36,\n        plans: [{ months: 36, interest: 0 }]\n      },\n      {\n        name: \"Mylo\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/ylo.jpg?v=1790781621\",\n        maxMonths: 24,\n        plans: [{ months: 24, interest: 0 }]\n      },\n      {\n        name: \"Tru\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/TRU_Logo.png?v=1790784359\",\n        maxMonths: 12,\n        plans: [{ months: 24, interest: 0 }]\n      },\n      {\n        name: \"Forsa\",\n        logo: \"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/Forsa.webp?v=1790784332\",\n        maxMonths: 36,\n        plans: [{ months: 36, interest: 0 }]\n      }\n    ];\n\n    var section = document.getElementById(\"bnpl-calc\");\n\n    if (!section) return;\n\n    var providersEl =\n      section.querySelector(\"[data-bnpl-providers]\");\n\n    var priceEl =\n      section.querySelector(\"[data-bnpl-price]\");\n\n    var durationEl =\n      section.querySelector(\"[data-bnpl-duration]\");\n\n    var amountEl =\n      section.querySelector(\"[data-bnpl-amount]\");\n\n    var titleEl =\n      section.querySelector(\"[data-bnpl-title]\");\n\n    var subtitleEl =\n      section.querySelector(\"[data-bnpl-subtitle]\");\n\n    var cardTitleEl =\n      section.querySelector(\"[data-bnpl-card-title]\");\n\n    var priceLabelEl =\n      section.querySelector(\"[data-bnpl-price-label]\");\n\n    var durationLabelEl =\n      section.querySelector(\"[data-bnpl-duration-label]\");\n\n    var paymentLabelEl =\n      section.querySelector(\"[data-bnpl-payment-label]\");\n\n    var unitEl =\n      section.querySelector(\"[data-bnpl-unit]\");\n\n    var isArabic =\n      window.location.pathname === \"/ar\" ||\n      window.location.pathname.indexOf(\"/ar/\") === 0 ||\n      document.documentElement.lang.toLowerCase().indexOf(\"ar\") === 0;\n\n    var TEXT = {\n      en: {\n        title: \"Buy now pay later\",\n        subtitle: \"Furnish your home your way, with multiple installment systems up to 61 months.\",\n        cardTitle: \"Installment Calculator\",\n        priceLabel: \"Product price (EGP)\",\n        durationLabel: \"Duration\",\n        paymentLabel: \"Monthly payment\",\n        unit: \"EGP / month\",\n        chooseProvider: \"Choose a provider\",\n        rateUnavailable: \"Rate unavailable\",\n        months: \"months\",\n        upTo: \"Up to\"\n      },\n\n      ar: {\n        title: \"الشراء الآن والدفع لاحقًا\",\n        subtitle: \"جهّز بيتك بالطريقة اللي تناسبك، بأنظمة تقسيط متعددة لحد 61 شهر.\",\n        cardTitle: \"حاسبة التقسيط\",\n        priceLabel: \"سعر المنتج (جنيه مصري)\",\n        durationLabel: \"مدة التقسيط\",\n        paymentLabel: \"القسط الشهري\",\n        unit: \"جنيه / شهر\",\n        chooseProvider: \"اختر جهة التقسيط\",\n        rateUnavailable: \"بيانات التقسيط غير متاحة\",\n        months: \"شهر\",\n        upTo: \"حتى\"\n      }\n    };\n\n    var language =\n      isArabic ? TEXT.ar : TEXT.en;\n\n    if (isArabic) {\n      section.setAttribute(\"dir\", \"rtl\");\n      section.setAttribute(\"lang\", \"ar\");\n    } else {\n      section.setAttribute(\"dir\", \"ltr\");\n      section.setAttribute(\"lang\", \"en\");\n    }\n\n    titleEl.textContent =\n      language.title;\n\n    subtitleEl.textContent =\n      language.subtitle;\n\n    cardTitleEl.textContent =\n      language.cardTitle;\n\n    priceLabelEl.textContent =\n      language.priceLabel;\n\n    durationLabelEl.textContent =\n      language.durationLabel;\n\n    paymentLabelEl.textContent =\n      language.paymentLabel;\n\n    unitEl.textContent =\n      language.unit;\n\n    providersEl.setAttribute(\n      \"aria-label\",\n      language.chooseProvider\n    );\n\n    var formatter = new Intl.NumberFormat(\n      isArabic ? \"ar-EG\" : \"en-EG\",\n      {\n        maximumFractionDigits: 0\n      }\n    );\n\n    var selected = 0;\n\n    function monthlyPayment(provider, price, months) {\n      var plan = null;\n\n      for (var i = 0; i < provider.plans.length; i++) {\n        if (provider.plans[i].months === months) {\n          plan = provider.plans[i];\n          break;\n        }\n      }\n\n      if (!plan) {\n        return null;\n      }\n\n      var feesRate =\n        plan.interest / 100;\n\n      return (\n        price * (1 + feesRate)\n      ) / months;\n    }\n\n    function render() {\n      var provider = PROVIDERS[selected];\n\n      var price =\n        Math.max(\n          0,\n          parseFloat(priceEl.value) || 0\n        );\n\n      if (!provider.plans || provider.plans.length === 0) {\n        amountEl.textContent =\n          language.rateUnavailable;\n        return;\n      }\n\n      var months =\n        parseInt(durationEl.value, 10);\n\n      var payment =\n        monthlyPayment(\n          provider,\n          price,\n          months\n        );\n\n      if (payment === null) {\n        amountEl.textContent =\n          language.rateUnavailable;\n        return;\n      }\n\n      amountEl.textContent =\n        formatter.format(payment);\n    }\n\n    function renderDurations() {\n      var provider =\n        PROVIDERS[selected];\n\n      durationEl.innerHTML = \"\";\n\n      if (\n        provider.plans &&\n        provider.plans.length > 0\n      ) {\n        provider.plans.forEach(\n          function (plan) {\n\n            var option =\n              document.createElement(\"option\");\n\n            option.value =\n              plan.months;\n\n            if (isArabic) {\n              option.textContent =\n                plan.months +\n                \" \" +\n                language.months +\n                \" (\" +\n                plan.interest +\n                \"%)\";\n            } else {\n              option.textContent =\n                plan.months +\n                \" \" +\n                language.months +\n                \" (\" +\n                plan.interest +\n                \"%)\";\n            }\n\n            durationEl.appendChild(option);\n          }\n        );\n      } else {\n        var option =\n          document.createElement(\"option\");\n\n        option.value = \"\";\n\n        if (isArabic) {\n          option.textContent =\n            language.upTo +\n            \" \" +\n            provider.maxMonths +\n            \" \" +\n            language.months;\n        } else {\n          option.textContent =\n            language.upTo +\n            \" \" +\n            provider.maxMonths +\n            \" \" +\n            language.months;\n        }\n\n        durationEl.appendChild(option);\n      }\n    }\n\n    function select(index) {\n      selected = index;\n\n      Array.prototype.forEach.call(\n        providersEl.children,\n        function (pill, pillIndex) {\n          pill.setAttribute(\n            \"aria-pressed\",\n            String(pillIndex === index)\n          );\n        }\n      );\n\n      renderDurations();\n      render();\n    }\n\n    function renderProviders() {\n\n      PROVIDERS.forEach(\n        function (provider, index) {\n\n          var pill =\n            document.createElement(\"button\");\n\n          pill.type = \"button\";\n\n          pill.className =\n            \"bnpl-calc__pill\";\n\n          pill.setAttribute(\n            \"aria-label\",\n            provider.name\n          );\n\n          pill.setAttribute(\n            \"title\",\n            provider.name\n          );\n\n          pill.setAttribute(\n            \"aria-pressed\",\n            \"false\"\n          );\n\n          if (provider.logo) {\n            var logo =\n              document.createElement(\"img\");\n\n            logo.className =\n              \"bnpl-calc__pill-logo\";\n\n            logo.src =\n              provider.logo;\n\n            logo.alt =\n              provider.name + \" logo\";\n\n            logo.loading = \"lazy\";\n\n            logo.decoding = \"async\";\n\n            logo.onerror = function () {\n              this.style.display = \"none\";\n\n              var text =\n                document.createElement(\"span\");\n\n              text.textContent =\n                provider.name;\n\n              pill.appendChild(text);\n            };\n\n            pill.appendChild(logo);\n          } else {\n            pill.textContent =\n              provider.name;\n          }\n\n          pill.addEventListener(\n            \"click\",\n            function () {\n              select(index);\n            }\n          );\n\n          providersEl.appendChild(pill);\n        }\n      );\n    }\n\n    renderProviders();\n    select(0);\n\n    priceEl.addEventListener(\n      \"input\",\n      render\n    );\n\n    durationEl.addEventListener(\n      \"change\",\n      render\n    );\n\n  })();\n</script>",
        "text_alignment": "start"
      }
    },
