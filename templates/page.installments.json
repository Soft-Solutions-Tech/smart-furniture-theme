        height=\"22\"\n          >\n        {% else %}\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-11.png?v=1790952998\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n        {% endif %}\n      </span>\n      <div class=\"trust-badges__text\">\n        {% if is_arabic %}\n          <p class=\"trust-badges__title\">الضمان</p>\n          <p class=\"trust-badges__subtitle\">ضمان على منتجاتنا</p>\n        {% else %}\n          <p class=\"trust-badges__title\">Warranty</p>\n          <p class=\"trust-badges__subtitle\">Warranty-backed products</p>\n        {% endif %}\n      </div>\n    </div>\n\n  </div>\n</section>",
