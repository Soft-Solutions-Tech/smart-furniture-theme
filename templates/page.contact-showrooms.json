hopify.com/s/files/1/0978/4967/2043/files/icons_des-01-02.png?v=1790952942\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">تركيب مجاني</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">تركيب مجاني لمنتجاتنا</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Free Installation</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Professional installation included</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 3. FREE SHIPPING -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01.png?v=1790952950\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01.png?v=1790952950\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">شحن مجاني</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">بدون رسوم شحن</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Free Shipping</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">No shipping fees</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 4. HOTLINE -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=