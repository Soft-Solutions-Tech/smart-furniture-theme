er-box;\n  }\n\n  .trust-badges__item {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n  }\n\n  .trust-badges__icon {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 42px;\n    height: 42px;\n    flex-shrink: 0;\n    border-radius: 11px;\n    background: var(--tb-navy);\n  }\n  .trust-badges__icon img {\n    width: 22px;\n    height: 22px;\n    object-fit: contain;\n  }\n\n  .trust-badges__title {\n    margin: 0 0 2px;\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1.2;\n    letter-spacing: -0.01em;\n  }\n  .trust-badges__subtitle {\n    margin: 0;\n    font-size: 12px;\n    line-height: 1.3;\n    color: var(--tb-muted);\n  }\n\n  \/* ══ Responsive ══ *\/\n  @media screen and (max-width: 767px) {\n    .trust-badges__inner {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 18px 20px;\n    }\n  }\n  @media screen and (max-width: 399px) {\n    .trust-badges__inner {\n      grid-template-columns: 1fr;\n    }\n  }\n<\/style>\n\n<section class=\"trust-badges\" aria-label=\"Why shop with us\">\n  <div class=\"trust-badges__inner\">\n    <div class=\"trust-badges__item\">\n      <span class=\"trust-badges__icon\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/factory-icon.png?v=1784372578\"\n          alt=\"\"\n          loading=\"lazy\"\n          decoding=\"async\"\n          width=\"22\"\n          height=\"22\"\n        \/>\n      <\/span>\n      <div>\n        <p class=\"trust-badges__title\">Factory-direct price<\/p>\n        <p class=\"trust-badges__subtitle\">No middleman markup<\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"trust-badges__item\">\n      <span class=\"trust-badges__icon\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/truck-icon.png?v=1784372594\"\n          alt=\"\"\n          loading=\"lazy\"\n          decoding=\"async\"\n          width=\"22\"\n          height=\"22\"\n        \/>\n      <\/span>\n      <div>\n        <p class=\"trust-badges__title\">Free delivery &amp; assembly<\/p>\n        <p class=\"trust-badges__subtitle\">On every order, everywhere<\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"trust-badges__item\">\n      <span class=\"trust-badges__icon\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/warranty-Icon.png?v=1784372586\"\n          alt=\"\"\n          loading=\"lazy\"\n          decoding=\"async\"\n          width=\"22\"\n          height=\"22\"\n        \/>\n      <\/span>\n      <div>\n        <p class=\"trust-badges__title\">5-year maker's warranty<\/p>\n        <p class=\"trust-badges__subtitle\">Backed by us, not a policy<\/p>\n      <\/div>\n    <\/div>\n\n    <div class=\"trust-badges__item\">\n      <span class=\"trust-badges__icon\">\n        <img\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/location-icon.png?v=1784372581\"\n          alt=\"\"\n          loading=\"lazy\"\n          decoding=\"async\"\n          width=\"22\"\n          height=\"22\"\n        \/>\n      <\/span>\n      <div>\n        <p class=\"trust-badges__title\">30+ showrooms across Egypt<\/p>\n        <p class=\"trust-badges__subtitle\">See it in person before you buy<\/p>\n      <\/div>\n    <\/div>\n  <\/div>\n<\/section>","text_alignment":"center"}},"1790784958e87d1dd4":{"type":"apps","blocks":{"forms_inline_3TjCN3":{"type":"shopify:\/\/apps\/forms\/blocks\/inline\/8744a304-fcb1-4347-b211-bb6b4759a76a","settings":{"form_id":"1177411","text_color":"#202020","button_background_color":"#202020","button_label_color":"#ffffff","links_color":"#1878b9","errors_color":"#e02229","text_alignment":"center","form_alignment":"center","padding_top":0,"padding_bottom":24,"padding_right":0,"padding_left":0}}},"block_order":["forms_inline_3TjCN3"],"settings":{"color_scheme":"","separate_section_with_border":true,"remove_verti