    "custom_liquid_iXr8Lm": {
      "type": "custom-liquid",
      "name": "USPs ",
      "settings": {
        "color_scheme": "",
        "separate_section_with_border": false,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<!-- ════════════════════════════════════════════════════════════════════════\n     Smart Furniture USP Strip\n     Unique class names to avoid CSS conflicts\n     Desktop: 6 columns full width\n     Mobile: 2 columns = 3 rows\n     ════════════════════════════════════════════════════════════════════ -->\n\n{%- assign is_arabic = false -%}\n{%- if localization.language.iso_code == 'ar' -%}\n  {%- assign is_arabic = true -%}\n{%- endif -%}\n\n<style>\n  .sf-usp-strip-v1 {\n    --sf-usp-navy: #002659;\n    --sf-usp-yellow: #fad163;\n\n    --sf-usp-ink: #16181d;\n    --sf-usp-muted: #8a9099;\n\n    --sf-usp-font: inherit;\n\n    width: 100%;\n    margin: 0;\n    padding: 0;\n\n    background: #ffffff;\n    color: var(--sf-usp-ink);\n\n    font-family: var(--sf-usp-font);\n  }\n\n  /* ==================================================\n     DESKTOP\n     6 EQUAL COLUMNS × 1 ROW\n     ================================================== */\n\n  .sf-usp-strip-v1 > .sf-usp-strip-v1__inner {\n    display: grid !important;\n\n    grid-template-columns: repeat(6, minmax(0, 1fr)) !important;\n    grid-template-rows: 1fr !important;\n\n    width: 100% !important;\n    max-width: none !important;\n\n    margin: 0 !important;\n\n    padding: 24px 22px !important;\n\n    column-gap: 10px !important;\n    row-gap: 0 !important;\n\n    box-sizing: border-box;\n  }\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__item {\n    display: grid !important;\n\n    grid-template-columns: 68px minmax(0, 1fr) !important;\n\n    align-items: center;\n\n    column-gap: 12px;\n\n    width: 100% !important;\n    min-width: 0 !important;\n\n    padding-inline: 6px;\n\n    box-sizing: border-box;\n  }\n\n  /* ==================================================\n     ICON BOX\n     BIGGER BOX TO FIT ARTWORK\n     ================================================== */\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__icon {\n    display: flex !important;\n\n    align-items: center;\n    justify-content: center;\n\n    width: 68px !important;\n    height: 68px !important;\n\n    min-width: 68px !important;\n    min-height: 68px !important;\n\n    flex: 0 0 68px !important;\n\n    border-radius: 16px !important;\n\n    background: var(--sf-usp-navy);\n\n    overflow: hidden;\n\n    box-sizing: border-box;\n  }\n\n  /* ==================================================\n     USP ARTWORK\n     ================================================== */\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__icon img {\n    display: block;\n\n    width: 50px !important;\n    height: 50px !important;\n\n    max-width: none !important;\n    max-height: none !important;\n\n    object-fit: contain;\n\n    transform: scale(1.38) !important;\n    transform-origin: center !important;\n  }\n\n  /* ==================================================\n     TEXT\n     ================================================== */\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__text {\n    display: grid;\n\n    grid-template-rows: 20px 18px;\n\n    align-content: center;\n\n    min-width: 0;\n\n    text-align: left;\n  }\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__title {\n    display: block;\n\n    width: 100%;\n\n    margin: 0;\n\n    font-size: clamp(12px, 0.8vw, 14px);\n    font-weight: 700;\n\n    line-height: 20px;\n\n    letter-spacing: -0.01em;\n\n    white-space: nowrap;\n  }\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__subtitle {\n    display: block;\n\n    width: 100%;\n\n    margin: 0;\n\n    font-size: clamp(10px, 0.66vw, 12px);\n\n    line-height: 18px;\n\n    letter-spacing: -0.015em;\n\n    color: var(--sf-usp-muted);\n\n    white-space: nowrap;\n  }\n\n  /* ==================================================\n     ARABIC\n     ================================================== */\n\n  .sf-usp-strip-v1--arabic {\n    direction: rtl;\n  }\n\n  .sf-usp-strip-v1--arabic .sf-usp-strip-v1__item {\n    direction: rtl;\n  }\n\n  .sf-usp-strip-v1--arabic .sf-usp-strip-v1__text {\n    text-align: right;\n  }\n\n  /* ========