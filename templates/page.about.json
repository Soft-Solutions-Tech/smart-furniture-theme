    "custom_liquid_QfGMqE": {
      "type": "custom-liquid",
      "name": "USPs ",
      "settings": {
        "color_scheme": "",
        "separate_section_with_border": false,
        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "<!-- ════════════════════════════════════════════════════════════════════════\n     Smart Furniture USP Strip\n     Unique class names to avoid CSS conflicts\n     Desktop: 6 columns full width\n     Mobile: 2 columns = 3 rows\n     ════════════════════════════════════════════════════════════════════ -->\n\n{%- assign is_arabic = false -%}\n{%- if localization.language.iso_code == 'ar' -%}\n  {%- assign is_arabic = true -%}\n{%- endif -%}\n\n<style>\n  .sf-usp-strip-v1 {\n    --sf-usp-navy: #002659;\n    --sf-usp-yellow: #fad163;\n\n    --sf-usp-ink: #16181d;\n    --sf-usp-muted: #8a9099;\n\n    --sf-usp-font: inherit;\n\n    width: 100%;\n    margin: 0;\n    padding: 0;\n\n    background: #ffffff;\n    color: var(--sf-usp-ink);\n\n    font-family: var(--sf-usp-font);\n  }\n\n  /* ==================================================\n     DESKTOP\n     6 EQUAL COLUMNS × 1 ROW\n     ================================================== */\n\n  .sf-usp-strip-v1 > .sf-usp-strip-v1__inner {\n    display: grid !important;\n\n    grid-template-columns: repeat(6, minmax(0, 1fr)) !important;\n    grid-template-rows: 1fr !important;\n\n    width: 100% !important;\n    max-width: none !important;\n\n    margin: 0 !important;\n\n    padding: 24px 22px !important;\n\n    column-gap: 10px !important;\n    row-gap: 0 !important;\n\n    box-sizing: border-box;\n  }\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__item {\n    display: grid !important;\n\n    grid-template-columns: 68px minmax(0, 1fr) !important;\n\n    align-items: center;\n\n    column-gap: 12px;\n\n    width: 100% !important;\n    min-width: 0 !important;\n\n    padding-inline: 6px;\n\n    box-sizing: border-box;\n  }\n\n  /* ==================================================\n     ICON BOX\n     BIGGER BOX TO FIT ARTWORK\n     ================================================== */\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__icon {\n    display: flex !important;\n\n    align-items: center;\n    justify-content: center;\n\n    width: 68px !important;\n    height: 68px !important;\n\n    min-width: 68px !important;\n    min-height: 68px !important;\n\n    flex: 0 0 68px !important;\n\n    border-radius: 16px !important;\n\n    background: var(--sf-usp-navy);\n\n    overflow: hidden;\n\n    box-sizing: border-box;\n  }\n\n  /* ==================================================\n     USP ARTWORK\n     ================================================== */\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__icon img {\n    display: block;\n\n    width: 50px !important;\n    height: 50px !important;\n\n    max-width: none !important;\n    max-height: none !important;\n\n    object-fit: contain;\n\n    transform: scale(1.38) !important;\n    transform-origin: center !important;\n  }\n\n  /* ==================================================\n     TEXT\n     ================================================== */\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__text {\n    display: grid;\n\n    grid-template-rows: 20px 18px;\n\n    align-content: center;\n\n    min-width: 0;\n\n    text-align: left;\n  }\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__title {\n    display: block;\n\n    width: 100%;\n\n    margin: 0;\n\n    font-size: clamp(12px, 0.8vw, 14px);\n    font-weight: 700;\n\n    line-height: 20px;\n\n    letter-spacing: -0.01em;\n\n    white-space: nowrap;\n  }\n\n  .sf-usp-strip-v1 .sf-usp-strip-v1__subtitle {\n    display: block;\n\n    width: 100%;\n\n    margin: 0;\n\n    font-size: clamp(10px, 0.66vw, 12px);\n\n    line-height: 18px;\n\n    letter-spacing: -0.015em;\n\n    color: var(--sf-usp-muted);\n\n    white-space: nowrap;\n  }\n\n  /* ==================================================\n     ARABIC\n     ================================================== */\n\n  .sf-usp-strip-v1--arabic {\n    direction: rtl;\n  }\n\n  .sf-usp-strip-v1--arabic .sf-usp-strip-v1__item {\n    direction: rtl;\n  }\n\n  .sf-usp-strip-v1--arabic .sf-usp-strip-v1__text {\n    text-align: right;\n  }\n\n  /* ==================================================\n     MOBILE\n     2 COLUMNS × 3 ROWS\n     ================================================== */\n\n  @media screen and (max-width: 767px) {\n\n    .sf-usp-strip-v1 > .sf-usp-strip-v1__inner {\n      display: grid !important;\n\n      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;\n      grid-template-rows: repeat(3, auto) !important;\n\n      width: 100% !important;\n\n      padding: 20px 12px !important;\n\n      column-gap: 12px !important;\n      row-gap: 22px !important;\n    }\n\n    .sf-usp-strip-v1 .sf-usp-strip-v1__item {\n      display: grid !important;\n\n      grid-template-columns: 60px minmax(0, 1fr) !important;\n\n      align-items: center;\n\n      column-gap: 10px;\n\n      width: 100% !important;\n\n      padding-inline: 5px;\n    }\n\n    /* Bigger mobile box */\n\n    .sf-usp-strip-v1 .sf-usp-strip-v1__icon {\n      width: 60px !important;\n      height: 60px !important;\n\n      min-width: 60px !important;\n      min-height: 60px !important;\n\n      flex: 0 0 60px !important;\n\n      border-radius: 14px !important;\n    }\n\n    /* Mobile artwork */\n\n    .sf-usp-strip-v1 .sf-usp-strip-v1__icon img {\n      width: 44px !important;\n      height: 44px !important;\n\n      max-width: none !important;\n      max-height: none !important;\n\n      transform: scale(1.34) !important;\n      transform-origin: center !important;\n    }\n\n    .sf-usp-strip-v1 .sf-usp-strip-v1__text {\n      display: flex;\n\n      flex-direction: column;\n      justify-content: center;\n\n      min-height: 60px;\n    }\n\n    .sf-usp-strip-v1 .sf-usp-strip-v1__title {\n      margin: 0 0 3px;\n\n      font-size: 12px;\n\n      line-height: 1.2;\n\n      white-space: normal;\n    }\n\n    .sf-usp-strip-v1 .sf-usp-strip-v1__subtitle {\n      margin: 0;\n\n      min-height: 28px;\n\n      font-size: 10px;\n\n      line-height: 1.4;\n\n      white-space: normal;\n    }\n  }\n</style>\n\n<section\n  class=\"sf-usp-strip-v1 {% if is_arabic %}sf-usp-strip-v1--arabic{% endif %}\"\n  {% if is_arabic %}\n    dir=\"rtl\"\n    aria-label=\"مميزات التسوق\"\n  {% else %}\n    dir=\"ltr\"\n    aria-label=\"Why shop with us\"\n  {% endif %}\n>\n\n  <div class=\"sf-usp-strip-v1__inner\">\n\n    <!-- 1. DELIVERY -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-09_0b70b216-49a8-4e10-a4df-a7c3114273d7.png?v=1790953733\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-05.png?v=1790952866\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">التوصيل</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">توصيل خلال 48 ساعة</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Delivery</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">48 hours delivery</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 2. FREE INSTALLATION -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-07.png?v=1790952938\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-02.png?v=1790952942\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">تركيب مجاني</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">تركيب احترافي مجاني</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Free Installation</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Free professional<br>installation</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 3. FREE SHIPPING -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01.png?v=1790952950\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01.png?v=1790952950\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">شحن مجاني</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">توصيل مجاني</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Free Shipping</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">No shipping fees</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 4. HOTLINE -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-10.png?v=1790952957\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-04.png?v=1790952962\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">الخط الساخن</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">نحن هنا لمساعدتك</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Hotline</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">We're here to help</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 5. INSTALLMENTS -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-08.png?v=1790952967\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-03.png?v=1790952971\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">التقسيط</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">أنظمة دفع مرنة</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Installments</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Flexible payment options</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 6. WARRANTY -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-14.png?v=1790952981\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-11.png?v=1790952998\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">الضمان</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">ضمان مكتوب 5 سنين</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Warranty</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">5 years written warranty</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n  </div>\n</section>",
        "text_alignment": "center"
      }
    }
