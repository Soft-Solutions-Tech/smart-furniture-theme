{"sections":{"main":{"type":"main-page","disabled":true,"settings":{"color_scheme":"","show_title":true,"page_width":"xs"}},"slideshow_kbJfiY":{"type":"slideshow","blocks":{"image_7bMKEm":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/about-banner.jpg","subheading":"","title":"","heading_style":"h1","mobile_text_position":"place-self-center text-center","desktop_text_position":"sm:place-self-center sm:text-center","content_max_width":780,"button_1_text":"","button_1_link":"","button_1_style":"solid","button_1_background":"#ffffff","button_1_text_color":"#000000","button_2_text":"","button_2_link":"","button_2_style":"outline","button_2_background":"#ffffff","button_2_text_color":"#000000","background":"","background_opacity":50,"text_color":"#ffffff","border_color":"","gradient_overlay":"linear-gradient(180deg, rgba(54, 54, 54, 0.04), rgba(4, 4, 4, 0.65) 100%)"}}},"block_order":["image_7bMKEm"],"name":"t:sections.slideshow.presets.slideshow.name","settings":{"allow_transparent_header":true,"show_next_section_button":true,"media_size":"auto","show_initial_transition":false,"autoplay":true,"autoplay_pause_on_video":true,"cycle_speed":5,"background":"#000000","controls_color":"#ffffff"}},"custom_liquid_LRrPqw":{"type":"custom-liquid","name":"Every Piece tells you a story ","settings":{"color_scheme":"","separate_section_with_border":false,"remove_vertical_spacing":true,"remove_horizontal_spacing":true,"liquid":"<!-- ════════════════════════════════════════════════════════════════════════\n     \"Every Piece Tells a Story\" — About section\n     Paste this whole block into a Custom Liquid \/ HTML section.\n     Feature cards live in the FEATURES array at the bottom of this file.\n     ════════════════════════════════════════════════════════════════════ -->\n<style>\n  .about {\n    \/* ── Smart Furniture palette ── *\/\n    --ab-navy: #002659;\n    --ab-yellow: #fad163;\n\n    \/* ── Neutrals ── *\/\n    --ab-ink: #16181d;\n    --ab-muted: #8a9099;\n    --ab-card: #f6f3ef;\n\n    \/* ── Type ── *\/\n    --ab-font: inherit; \/* set a stack here to override the theme font *\/\n\n    margin: 0;\n    padding: 0;\n    background: #fff;\n    color: var(--ab-ink);\n    font-family: var(--ab-font);\n  }\n\n  \/* The section stays flush; the inner wrapper carries all spacing. *\/\n  .about__inner {\n    max-width: 1200px;\n    margin-inline: auto;\n    padding-inline: clamp(20px, 4vw, 48px);\n    padding-block: clamp(40px, 5vw, 72px);\n    box-sizing: border-box;\n  }\n\n  \/* ══ Two-column layout ══ *\/\n  .about__grid {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    align-items: center;\n    gap: clamp(32px, 5vw, 72px);\n  }\n\n  .about__media {\n    margin: 0;\n  }\n  .about__image {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 1 \/ 1;\n    object-fit: cover;\n    border-radius: 18px;\n  }\n\n  \/* ══ Copy ══ *\/\n  .about__title {\n    margin: 0 0 20px;\n    font-size: clamp(32px, 4.4vw, 52px);\n    font-weight: 700;\n    line-height: 1.05;\n    letter-spacing: -0.03em;\n  }\n  .about__text {\n    max-width: 46ch;\n    margin: 0 0 16px;\n    font-size: 14px;\n    line-height: 1.65;\n    color: var(--ab-muted);\n  }\n  .about__text:last-of-type {\n    margin-bottom: 28px;\n  }\n\n  \/* ══ Feature cards ══ *\/\n  .about__features {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 14px;\n    margin-bottom: 28px;\n  }\n  .about__feature {\n    padding: 18px 20px;\n    border-radius: 12px;\n    background: var(--ab-card);\n  }\n  .about__feature-icon {\n    display: block;\n    width: 22px;\n    height: 22px;\n    margin-bottom: 12px;\n    object-fit: contain;\n  }\n  .about__feature-title {\n    margin: 0 0 4px;\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: -0.01em;\n  }\n  .about__feature-text {\n    margin: 0;\n    font-size: 12px;\n    line-height: 1.45;\n    color: var(--ab-muted);\n  }\n\n  \/* ══ Shop button ══ *\/\n  .about__btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 13px 24px;\n    border: 0;\n    border-radius: 999px;\n    background: var(--ab-navy);\n    font-family: inherit;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1;\n    color: #fff;\n    text-decoration: none;\n    cursor: pointer;\n    transition: background-color 0.2s ease;\n  }\n  .about__btn:hover {\n    background: #003d80;\n  }\n  .about__btn:focus-visible {\n    outline: 2px solid var(--ab-navy);\n    outline-offset: 3px;\n  }\n  .about__btn svg {\n    width: 13px;\n    height: 13px;\n    flex-shrink: 0;\n  }\n\n  \/* ══ Showroom banner ══ *\/\n  .about__banner {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    flex-wrap: wrap;\n    gap: clamp(20px, 3vw, 40px);\n    margin-top: clamp(32px, 4vw, 56px);\n    padding: clamp(28px, 4vw, 44px) clamp(28px, 4vw, 52px);\n    border-radius: 18px;\n    background: var(--ab-navy);\n    color: #fff;\n  }\n  .about__banner-title {\n    margin: 0 0 6px;\n    font-size: clamp(20px, 2.4vw, 26px);\n    font-weight: 700;\n    letter-spacing: -0.02em;\n  }\n  .about__banner-subtitle {\n    margin: 0;\n    font-size: clamp(13px, 1.5vw, 15px);\n    font-weight: 500;\n    color: var(--ab-yellow);\n  }\n  .about__banner-btn {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    padding: 14px 26px;\n    border: 2px solid #fff;\n    border-radius: 999px;\n    background: #fff;\n    font-family: inherit;\n    font-size: 14px;\n    font-weight: 700;\n    line-height: 1;\n    color: var(--ab-navy);\n    text-decoration: none;\n    white-space: nowrap;\n    cursor: pointer;\n    transition:\n      background-color 0.2s ease,\n      color 0.2s ease,\n      border-color 0.2s ease;\n  }\n  .about__banner-btn:hover {\n    background: var(--ab-yellow);\n    border-color: var(--ab-yellow);\n  }\n  .about__banner-btn:focus-visible {\n    outline: 2px solid var(--ab-yellow);\n    outline-offset: 3px;\n  }\n  .about__banner-btn svg {\n    width: 14px;\n    height: 14px;\n    flex-shrink: 0;\n  }\n\n  \/* ══ Responsive ══ *\/\n  @media screen and (max-width: 899px) {\n    .about__grid {\n      grid-template-columns: 1fr;\n      gap: 32px;\n    }\n    .about__text {\n      max-width: none;\n    }\n  }\n  @media screen and (max-width: 479px) {\n    .about__features {\n      grid-template-columns: 1fr;\n    }\n    .about__banner {\n      flex-direction: column;\n      align-items: flex-start;\n    }\n    .about__banner-btn {\n      width: 100%;\n      box-sizing: border-box;\n    }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .about__btn,\n    .about__banner-btn {\n      transition: none;\n    }\n  }\n<\/style>\n\n<section class=\"about\" aria-labelledby=\"about-title\">\n  <div class=\"about__inner\">\n    <div class=\"about__grid\">\n      <!-- ── Image ── -->\n      <figure class=\"about__media\">\n        <img\n          class=\"about__image\"\n          src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/about-banner.jpg?v=1784679057\"\n          alt=\"A furnished Smart Furniture living room with a sectional sofa\"\n          loading=\"lazy\"\n          decoding=\"async\"\n        \/>\n      <\/figure>\n\n      <!-- ── Copy ── -->\n      <div class=\"about__content\">\n        <h2 class=\"about__title\" id=\"about-title\">Every Piece Tells a Story<\/h2>\n\n        <p class=\"about__text\">\n          Smart Furniture was built on a simple belief — every Egyptian family\n          deserves a home they're proud of, at a price that makes sense.\n        <\/p>\n        <p class=\"about__text\">\n          We design and manufacture everything in our own factories, giving us\n          full control over quality, design, and delivery. From the first sketch\n          to your front door.\n        <\/p>\n\n        <div class=\"about__features\" data-about-features><\/div>\n\n        <a class=\"about__btn\" href=\"\/collections\/all\">\n          Shop Our Products\n          <svg\n            viewBox=\"0 0 24 24\"\n            fill=\"none\"\n            stroke=\"currentColor\"\n            stroke-width=\"2.5\"\n            stroke-linecap=\"round\"\n            stroke-linejoin=\"round\"\n            aria-hidden=\"true\"\n            focusable=\"false\"\n          >\n            <line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\" \/>\n            <polyline points=\"13 5 20 12 13 19\" \/>\n          <\/svg>\n        <\/a>\n      <\/div>\n    <\/div>\n\n    <!-- ── Showroom banner ── -->\n    <div class=\"about__banner\">\n      <div>\n        <h3 class=\"about__banner-title\">Come see us in person.<\/h3>\n        <p class=\"about__banner-subtitle\">30+ showrooms across Egypt.<\/p>\n      <\/div>\n\n      <a class=\"about__banner-btn\" href=\"\/pages\/contact-showrooms\">\n        Find Nearest Showroom\n        <svg\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2.5\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n          focusable=\"false\"\n        >\n          <line x1=\"4\" y1=\"12\" x2=\"20\" y2=\"12\" \/>\n          <polyline points=\"13 5 20 12 13 19\" \/>\n        <\/svg>\n      <\/a>\n    <\/div>\n  <\/div>\n<\/section>\n\n<script>\n  (function () {\n    var FEATURES = [\n      {\n        icon: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/factory-icon-2.svg?v=1784563574\",\n        title: \"Made in Egypt\",\n        text: \"100% designed and manufactured locally.\",\n      },\n      {\n        icon: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/warranty-icon-2.svg?v=1784563578\",\n        title: \"5-Year Warranty\",\n        text: \"Every product is backed from day one.\",\n      },\n      {\n        icon: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/truck-icon-2.svg?v=1784563570\",\n        title: \"48h Delivery\",\n        text: \"Fast delivery across all governorates.\",\n      },\n      {\n        icon: \"https:\/\/cdn.shopify.com\/s\/files\/1\/0978\/4967\/2043\/files\/wallet-icon.svg?v=1784563135\",\n        title: \"Easy Installments\",\n        text: \"0% interest with all major partners.\",\n      },\n    ];\n\n    var grid = document.querySelector(\"[data-about-features]\");\n    if (!grid) return;\n\n    FEATURES.forEach(function (feature) {\n      var card = document.createElement(\"div\");\n      card.className = \"about__feature\";\n\n      var icon = document.createElement(\"img\");\n      icon.className = \"about__feature-icon\";\n      icon.src = feature.icon;\n      icon.alt = \"\";\n      icon.loading = \"lazy\";\n      icon.decoding = \"async\";\n      icon.width = 22;\n      icon.height = 22;\n\n      var title = document.createElement(\"h4\");\n      title.className = \"about__feature-title\";\n      title.textContent = feature.title;\n\n      var text = document.createElement(\"p\");\n      text.className = \"about__feature-text\";\n      text.textContent = feature.text;\n\n      card.appendChild(icon);\n      card.appendChild(title);\n      card.appendChild(text);\n      grid.appendChild(card);\n    });\n  })();\n<\/script>","text_alignment":"start"}}},"order":["main","slideshow_kbJfiY","custom_liquid_LRrPqw"]}