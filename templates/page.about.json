hopify.com/s/files/1/0978/4967/2043/files/icons_des-01-02.png?v=1790952942\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">تركيب مجاني</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">تركيب مجاني لمنتجاتنا</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Free Installation</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Professional installation included</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 3. FREE SHIPPING -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01.png?v=1790952950\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01.png?v=1790952950\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">شحن مجاني</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">بدون رسوم شحن</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Free Shipping</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">No shipping fees</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 4. HOTLINE -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-10.png?v=1790952957\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-04.png?v=1790952962\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">الخط الساخن</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">نحن هنا لمساعدتك</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Hotline</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">We're here to help</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 5. INSTALLMENTS -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-08.png?v=1790952967\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-03.png?v=1790952971\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">التقسيط</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">خيارات دفع مرنة</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Installments</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Flexible payment options</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 6. WARRANTY -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-14.png?v=1790952981\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-11.png?v=1790952998\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">الضمان</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">ضمان على منتجاتنا</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Warranty</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Warranty-backed products</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n  </div>\n</section>",
