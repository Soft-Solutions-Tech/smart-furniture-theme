\n          <p class=\"sf-usp-strip-v1__subtitle\">خيارات دفع مرنة</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Installments</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Flexible payment options</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n\n    <!-- 6. WARRANTY -->\n    <div class=\"sf-usp-strip-v1__item\">\n\n      <span class=\"sf-usp-strip-v1__icon\">\n\n        {% if is_arabic %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-14.png?v=1790952981\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% else %}\n\n          <img\n            src=\"https://cdn.shopify.com/s/files/1/0978/4967/2043/files/icons_des-01-11.png?v=1790952998\"\n            alt=\"\"\n            loading=\"lazy\"\n            decoding=\"async\"\n            width=\"22\"\n            height=\"22\"\n          >\n\n        {% endif %}\n\n      </span>\n\n      <div class=\"sf-usp-strip-v1__text\">\n\n        {% if is_arabic %}\n\n          <p class=\"sf-usp-strip-v1__title\">الضمان</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">ضمان على منتجاتنا</p>\n\n        {% else %}\n\n          <p class=\"sf-usp-strip-v1__title\">Warranty</p>\n          <p class=\"sf-usp-strip-v1__subtitle\">Warranty-backed products</p>\n\n        {% endif %}\n\n      </div>\n\n    </div>\n\n  </div>\n</section>",
