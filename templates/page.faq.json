        "richtext_yADGgW": {
          "type": "richtext",
          "settings": {
            "content": "<p><strong>Smart Furniture is a Joint Stock Company Part of a Worldwide European </strong>Egyptian Venture Founded in Austria in 1952 under the umbrella of S.A.I Solutions Corporation, Smart Furniture stores operated by us and some franchisees in more than 20 governates across Egypt. </p>"
          }
        }
