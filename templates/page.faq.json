        "question_aDVaqd": {
          "type": "question",
          "settings": {
            "question": "Do you have discounts for bulk or corporate purchases?&nbsp;",
            "answer": "<p>Yes, Smart Furniture offers <strong>special pricing for bulk orders and corporate clients</strong>. Please contact our sales team for personalized offers.</p>"
