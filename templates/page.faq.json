        "question_Nq4emP": {
          "type": "question",
          "settings": {
            "question": "Do you offer discounts on your products?&nbsp;",
            "answer": "<p>Yes, Smart Furniture occasionally offers <strong>special discounts and promotions</strong> across various collections. These can include seasonal offers, limited-time deals, and bundle promotions.</p>"
          }
        },
        "question_Yk9VX3": {
          "type": "question",
          "settings": {
            "question": "How can I find out about current promotions?&nbsp;",
            "answer": "<p>You can stay updated on all Smart Furniture promotions by:&nbsp;</p><ul><li>Visiting the <strong>Promotions</strong> section on our website&nbsp;</li><li>Following our <strong>social media channels</strong>&nbsp;</li><li>Subscribing to our <strong>newsletter</strong></li></ul>"
          }
