{%- doc -%}
This component renders all product-card and product-page badges in one place.

@param {object} product - the product to render badges for
@param {object} [variant] - the specific variant whose variant-level badge, availability, and exact discount may be used
@param {boolean} [vertical] - if true, render badges vertically
@param {string} [types] - comma-separated badge types: "custom", "last_chance", "sold_out", "discount"
@param {string} [context] - "product" uses the exact variant discount, "card" uses the highest product discount
@param {boolean} [include_custom] - whether variant and product custom badges should be rendered
{%- enddoc -%}

{%- liquid
assign badge_types = types | default: 'custom, last_chance, sold_out, discount' | split: ','
assign variant = variant | default: product.selected_or_first_available_variant
assign include_custom = include_custom | default: true, allow_false: true
assign is_last_chance = product.metafields.custom.last_chance.value
-%}

{%- capture badges -%}
  {%- for badge_type in badge_types -%}
    {%- assign stripped_badge_type = badge_type | strip -%}

    {%- case stripped_badge_type -%}

      {%- when 'custom' -%}
        {%- if include_custom -%}
          {%- assign variant_card_badge = variant.metafields.custom.card_badge.value -%}

          {%- if variant_card_badge != blank -%}
            {%- assign variant_badge_handle = variant_card_badge | handle -%}
            <span class="badge badge--custom badge--{{ variant_badge_handle }}">
              {%- case variant_badge_handle -%}
                {%- when 'new-arrival', 'new-arrivals' -%}
                  {{- 'product.general.new_arrival_badge' | t -}}
                {%- when 'bestseller', 'best-seller', 'bestsellers', 'best-sellers' -%}
                  {{- 'product.general.bestseller_badge' | t -}}
                {%- else -%}
                  {{- variant_card_badge -}}
              {%- endcase -%}
            </span>
          {%- endif -%}

          {%- assign custom_badges = product.metafields.custom.badges.value -%}

          {%- for custom_badge in custom_badges -%}
            {%- unless custom_badge == variant_card_badge -%}
              {%- assign custom_badge_handle = custom_badge | handle -%}
              <span class="badge badge--custom badge--{{ custom_badge_handle }}">
                {%- case custom_badge_handle -%}
                  {%- when 'new-arrival', 'new-arrivals' -%}
                    {{- 'product.general.new_arrival_badge' | t -}}
                  {%- when 'bestseller', 'best-seller', 'bestsellers', 'best-sellers' -%}
                    {{- 'product.general.bestseller_badge' | t -}}
                  {%- else -%}
                    {{- custom_badge -}}
                {%- endcase -%}
              </span>
            {%- endunless -%}
          {%- endfor -%}
        {%- endif -%}

      {%- when 'last_chance' -%}
        {%- if is_last_chance -%}
          <span class="badge badge--on-sale last-chance-badge">
            {{- 'product.general.last_chance_badge' | t -}}
          </span>
        {%- endif -%}

      {%- when 'sold_out' -%}
        {%- unless is_last_chance -%}
          {%- if settings.show_sold_out_badge and variant.available == false -%}
            <sold-out-badge class="badge badge--sold-out">
              {{- 'product.general.sold_out_badge' | t -}}
            </sold-out-badge>
          {%- endif -%}
        {%- endunless -%}

      {%- when 'discount' -%}
        {%- if settings.show_discount -%}

          {%- if context == 'product' -%}
            {%- if variant.compare_at_price > variant.price -%}
              {%- assign savings = variant.compare_at_price
                | minus: variant.price
                | times: 100.0
                | divided_by: variant.compare_at_price
                | round
              -%}

              <on-sale-badge class="badge badge--on-sale">
                -{{- savings -}}%
              </on-sale-badge>
            {%- endif -%}

          {%- elsif context == 'card' -%}
            {%- assign max_discount = 0 -%}

            {%- for badge_variant in product.variants -%}
              {%- if badge_variant.compare_at_price > badge_variant.price -%}
                {%- assign variant_discount = badge_variant.compare_at_price
                  | minus: badge_variant.price
                  | times: 100.0
                  | divided_by: badge_variant.compare_at_price
                  | round
                -%}

                {%- if variant_discount > max_discount -%}
                  {%- assign max_discount = variant_discount -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if max_discount > 0 -%}
              <on-sale-badge class="badge badge--on-sale">
                -{{- max_discount -}}%
              </on-sale-badge>
            {%- endif -%}
          {%- endif -%}

        {%- endif -%}

    {%- endcase -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if badges != blank -%}
  <badge-list class="badge-list{% if vertical %} badge-list--vertical{% endif %}">
    {{- badges -}}
  </badge-list>
{%- endif -%}