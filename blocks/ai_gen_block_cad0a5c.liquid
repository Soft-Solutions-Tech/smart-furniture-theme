{% doc %}
  @prompt
    Edit the product card snippet to match this styling:
    - Product image with a "15% OFF" badge in teal/green color at the top left corner
    - A wishlist/heart icon at the top right of the card
    - Below the image: small category label in uppercase gray text (e.g. "BEDROOM")
    - Product title in bold dark text
    - Sale price in bold dark text, original price with strikethrough next to it in gray
    - Orange colored text below the price showing installment info: "→ or EGP 2,075 / mo. Valu" with an arrow icon
    - A full-width dark navy "Add to Cart" button with a cart icon at the bottom
    - Clean white card background with subtle spacing
    - dynamic configured column grid layout
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-card-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-product-card-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-product-card-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }
  }

  .ai-product-card-item-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.3s ease;
  }

  .ai-product-card-item-{{ ai_gen_id }}:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
  }

  .ai-product-card-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 100%;
    overflow: hidden;
  }

  .ai-product-card-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-card-badge-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    left: 12px;
    background-color: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    z-index: 2;
  }

  .ai-product-card-wishlist-{{ ai_gen_id }} {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    background-color: {{ block.settings.wishlist_background }};
    border: none;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: transform 0.2s ease;
  }

  .ai-product-card-wishlist-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-product-card-wishlist-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.wishlist_icon_color }};
    fill: none;
    stroke-width: 2;
  }

  .ai-product-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }

  .ai-product-card-category-{{ ai_gen_id }} {
    font-size: 11px;
    text-transform: uppercase;
    color: {{ block.settings.category_color }};
    letter-spacing: 1px;
    font-weight: 600;
  }

  .ai-product-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-product-card-title-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-product-card-price-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-product-card-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    font-weight: 700;
    color: {{ block.settings.price_color }};
  }

  .ai-product-card-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size | minus: 2 }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-product-card-installment-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.installment_color }};
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .ai-product-card-installment-{{ ai_gen_id }} svg {
    width: 14px;
    height: 14px;
    fill: currentColor;
  }

  .ai-product-card-button-{{ ai_gen_id }} {
    width: 100%;
    padding: 14px 20px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: auto;
    transition: background-color 0.3s ease;
  }

  .ai-product-card-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
  }

  .ai-product-card-button-{{ ai_gen_id }} svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .ai-product-card-placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-product-card-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }
{% endstyle %}

<product-card-grid-{{ ai_gen_id }}
  class="ai-product-card-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-product-card-grid-{{ ai_gen_id }}">
    {% if block.settings.product_list != blank %}
      {% for product in block.settings.product_list limit: block.settings.products_to_show %}
        <div class="ai-product-card-item-{{ ai_gen_id }}">
          <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                class="ai-product-card-image-{{ ai_gen_id }}"
                loading="lazy"
                width="600"
                height="600"
              >
            {% else %}
              <div class="ai-product-card-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if product.compare_at_price > product.price %}
              {% assign discount_percentage = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
              <div class="ai-product-card-badge-{{ ai_gen_id }}">
                {{ discount_percentage }}% OFF
              </div>
            {% endif %}

            {% if block.settings.show_wishlist %}
              <button
                class="ai-product-card-wishlist-{{ ai_gen_id }}"
                aria-label="Add to wishlist"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            {% endif %}
          </div>

          <div class="ai-product-card-content-{{ ai_gen_id }}">
            {% if product.type != blank and block.settings.show_category %}
              <div class="ai-product-card-category-{{ ai_gen_id }}">
                {{ product.type }}
              </div>
            {% endif %}

            <h3 class="ai-product-card-title-{{ ai_gen_id }}">
              <a
                href="{{ product.url }}"
                class="ai-product-card-title-link-{{ ai_gen_id }}"
              >
                {{ product.title }}
              </a>
            </h3>

            <div class="ai-product-card-price-wrapper-{{ ai_gen_id }}">
              <span class="ai-product-card-price-{{ ai_gen_id }}">
                {{ product.price | money }}
              </span>
              {% if product.compare_at_price > product.price %}
                <span class="ai-product-card-compare-price-{{ ai_gen_id }}">
                  {{ product.compare_at_price | money }}
                </span>
              {% endif %}
            </div>

            {% if block.settings.show_installment and block.settings.installment_months > 0 %}
              {% assign monthly_payment = product.price | divided_by: block.settings.installment_months %}
              <div class="ai-product-card-installment-{{ ai_gen_id }}">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
                <span>or {{ monthly_payment | money }} / mo. {{ block.settings.installment_provider }}</span>
              </div>
            {% endif %}

            <button class="ai-product-card-button-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line
                  x1="3"
                  y1="6"
                  x2="21"
                  y2="6"
                ></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              {{ block.settings.button_text }}
            </button>
          </div>
        </div>
      {% endfor %}
    {% else %}
      {% for i in (1..block.settings.products_to_show) %}
        <div class="ai-product-card-item-{{ ai_gen_id }}">
          <div class="ai-product-card-image-wrapper-{{ ai_gen_id }}">
            <div class="ai-product-card-placeholder-{{ ai_gen_id }}">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>

            <div class="ai-product-card-badge-{{ ai_gen_id }}">15% OFF</div>

            {% if block.settings.show_wishlist %}
              <button
                class="ai-product-card-wishlist-{{ ai_gen_id }}"
                aria-label="Add to wishlist"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            {% endif %}
          </div>

          <div class="ai-product-card-content-{{ ai_gen_id }}">
            {% if block.settings.show_category %}
              <div class="ai-product-card-category-{{ ai_gen_id }}">BEDROOM</div>
            {% endif %}

            <h3 class="ai-product-card-title-{{ ai_gen_id }}">
              <a
                href="#"
                class="ai-product-card-title-link-{{ ai_gen_id }}"
              >
                Sample Product Title
              </a>
            </h3>

            <div class="ai-product-card-price-wrapper-{{ ai_gen_id }}">
              <span class="ai-product-card-price-{{ ai_gen_id }}">EGP 12,450</span>
              <span class="ai-product-card-compare-price-{{ ai_gen_id }}">EGP 14,650</span>
            </div>

            {% if block.settings.show_installment %}
              <div class="ai-product-card-installment-{{ ai_gen_id }}">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                >
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
                <span>or EGP 2,075 / mo. {{ block.settings.installment_provider }}</span>
              </div>
            {% endif %}

            <button class="ai-product-card-button-{{ ai_gen_id }}">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
              >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line
                  x1="3"
                  y1="6"
                  x2="21"
                  y2="6"
                ></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
              </svg>
              {{ block.settings.button_text }}
            </button>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</product-card-grid-{{ ai_gen_id }}>

<script>
  (function () {
    class ProductCardGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupWishlistButtons();
      }

      setupWishlistButtons() {
        const wishlistButtons = this.querySelectorAll('.ai-product-card-wishlist-{{ ai_gen_id }}');

        wishlistButtons.forEach((button) => {
          button.addEventListener('click', function (e) {
            e.preventDefault();
            const svg = this.querySelector('svg');
            const currentFill = svg.getAttribute('fill');

            if (currentFill === 'none' || !currentFill) {
              svg.setAttribute('fill', 'currentColor');
            } else {
              svg.setAttribute('fill', 'none');
            }
          });
        });
      }
    }

    customElements.define('product-card-grid-{{ ai_gen_id }}', ProductCardGrid{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Product card grid",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "label": "Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Border radius",
      "default": 8
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "color",
      "id": "badge_background",
      "label": "Background",
      "default": "#14b8a6"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Wishlist"
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist icon",
      "default": true
    },
    {
      "type": "color",
      "id": "wishlist_background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "wishlist_icon_color",
      "label": "Icon color",
      "default": "#1c1c1c"
    },
    {
      "type": "header",
      "content": "Category"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category",
      "default": true
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Color",
      "default": "#9ca3af"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Color",
      "default": "#1c1c1c"
    },
    {
      "type": "header",
      "content": "Price"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Color",
      "default": "#1c1c1c"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "label": "Compare price color",
      "default": "#9ca3af"
    },
    {
      "type": "header",
      "content": "Installment"
    },
    {
      "type": "checkbox",
      "id": "show_installment",
      "label": "Show installment info",
      "default": true
    },
    {
      "type": "range",
      "id": "installment_months",
      "min": 0,
      "max": 24,
      "step": 1,
      "label": "Number of months",
      "default": 6
    },
    {
      "type": "text",
