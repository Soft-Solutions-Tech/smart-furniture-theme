  "info": "t:sections.footer.blocks.links.menu_info",
  "default": "footer"
  },
  {
  "type": "checkbox",
  "id": "collapse_on_mobile",
  "label": "t:sections.footer.blocks.links.collapse_on_mobile",
  "default": false
  },
