<style>
#shopify-section-{{ section.id }} {
--footer-content-justify-items:
{% if section.settings.blocks.size <= 2 %}
  start
{% else %}
  space-between
{% endif %}
;
--footer-custom-column-gap: {{ section.settings.custom_column_gap | default: 48 }}px;
--footer-custom-item-gap: {{ section.settings.custom_item_gap | default: 14 }}px;
--footer-custom-columns: {{ section.settings.custom_desktop_columns | default: 5 }};
}
#shopify-section-{{ section.id }} .footer__block-list--custom-columns {
display: grid !important;
grid-template-columns: repeat(var(--footer-custom-columns), minmax(0, 1fr));
align-items: start;
gap: var(--footer-custom-column-gap);
}
#shopify-section-{{ section.id }} .footer__custom-column {
display: flex;
flex-direction: column;
align-items: flex-start;
gap: var(--footer-custom-item-gap);
min-width: 0;
}
#shopify-section-{{ section.id }} .footer__custom-column > .footer__block {
width: 100%;
max-width: none;
flex: none;
}
#shopify-section-{{ section.id }} .footer__custom-column .constrained-image {
display: block;
}

/* LAST CHANCE FOOTER LINK: match header red text + red dot */
#shopify-section-{{ section.id }} .footer__last-chance-link {
display: inline-flex;
align-items: center;
gap: 8px;
color: #e50b0b !important;
font-weight: 700 !important;
}

#shopify-section-{{ section.id }} .footer__last-chance-dot {
display: inline-block;
width: 9px;
height: 9px;
min-width: 9px;
flex: 0 0 9px;
border-radius: 50%;
background: #e50b0b;
}

@media screen and (max-width: 699px) {
/* On mobile, keep the custom desktop columns but flatten their spacing so
collapsed link menus look exactly like one clean accordion group. */
#shopify-section-{{ section.id }} .footer__block-list--custom-columns {
grid-template-columns: 1fr;
gap: 0;
}
#shopify-section-{{ section.id }} .footer__custom-column {
gap: var(--footer-custom-item-gap);
}
/* Give brand / image / text content breathing room before the menu accordions. */
#shopify-section-{{ section.id }} .footer__custom-column:not(:has(.footer__block--links)) {
margin-block-end: 1.25rem;
}
/* Link-only columns should join together with no large mobile gaps. */
#shopify-section-{{ section.id }} .footer__custom-column:has(.footer__block--links):not(:has(.footer__block--image)):not(:has(.footer__block--text)):not(:has(.footer__block--newsletter)):not(:has(.footer__block--app)) {
gap: 0;
margin: 0;
}
#shopify-section-{{ section.id }} .footer__custom-column .footer__block--links {
margin: 0;
}
/* Match Prestige's normal accordion-group border behavior even though
each menu may live in a different desktop footer column. */
#shopify-section-{{ section.id }} .footer__custom-column:has(.footer__block--links)
+ .footer__custom-column:has(.footer__block--links)
.accordion {
border-block-start-width: 0;
}
}
</style>
{%- assign color_scheme_hash = section.settings.color_scheme.settings.background_gradient | default: section.settings.color_scheme.settings.background | md5 -%}
<div class="footer color-scheme color-scheme--{{ section.settings.color_scheme.id }} color-scheme--bg-{{ color_scheme_hash }}
{% if section.settings.separate_section_with_border %}
  bordered-section
{% endif %}
">
<div class="container">

  <div class="footer__inner">
    {%- comment -%}
    ------------------------------------------------------------------------------------------------------------------
    FOOTER BLOCKS (MAIN CONTENT)
    ------------------------------------------------------------------------------------------------------------------
    {%- endcomment -%}

    {%- if section.blocks.size > 0 -%}
      {%- assign accordion_group_content = '' -%}
      {%- assign footer_column_1 = '' -%}
      {%- assign footer_column_2 = '' -%}
      {%- assign footer_column_3 = '' -%}
      {%- assign footer_column_4 = '' -%}
      {%- assign footer_column_5 = '' -%}
      {%- assign footer_column_6 = '' -%}

      {%- capture standard_footer_blocks -%}

        {%- for block in section.blocks -%}

          {%- capture block_content -%}

            {%- case block.type -%}

            {%- when '@app' -%}
              {%- render block -%}

            {%- when 'image' -%}

              {%- if block.settings.image != blank -%}

                {%- capture sizes -%}
                  {{ block.settings.image_width }}px

                {%- endcapture -%}

                {%- capture widths -%}
                  {{ block.settings.image_width }}, {{ block.settings.image_width | times: 2 | at_most: block.settings.image.width }}

                {%- endcapture -%}

                {%- capture style -%}
                  --image-max-width: {{ block.settings.image_width }}px

                {%- endcapture -%}

                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">
                  {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'constrained-image' -}}
                  </a>

                {%- else -%}
                  {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: sizes: sizes, widths: widths, style: style, class: 'constrained-image' -}}

                {%- endif -%}

              {%- endif -%}

            {%- when 'text' -%}

              {%- if block.settings.multiline_title != blank or block.settings.title != blank or block.settings.plain_text != blank or block.settings.content != blank or shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}

                <div class="v-stack gap-4 sm:gap-5">

                  {%- if block.settings.multiline_title != blank -%}

                    <p class="h6">
                    {{ block.settings.multiline_title | escape | newline_to_br }}

                    </p>

                  {%- elsif block.settings.title != blank -%}

                    <p class="h6">
                    {{ block.settings.title }}

                    </p>

                  {%- endif -%}

                  {%- if block.settings.plain_text != blank -%}

                    <div class="prose text-subdued">

                      <p>
                      {{ block.settings.plain_text | escape | newline_to_br }}

                      </p>

                    </div>

                  {%- elsif block.settings.content != blank -%}

                    <div class="prose text-subdued">
                      {{- block.settings.content -}}

                    </div>

                  {%- endif -%}

                  {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}

                    <div class="follow-on-shop">
                      {{- shop | login_button: action: 'follow' -}}

                    </div>

                  {%- endif -%}

                </div>

              {%- endif -%}

            {%- when 'links' -%}
              {%- assign menu = block.settings.menu -%}

              {%- if menu != blank and menu.links.size > 0 -%}
                {%- assign menu_title = block.settings.menu_title | default: menu.title -%}

                {%- capture menu_content -%}

                  <ul class="v-stack gap-2.5 unstyled-list" role="list">

                    {%- for link in menu.links -%}
                      {%- liquid
                        assign footer_link_title = link.title | strip | downcase
                        assign footer_link_url = link.url | downcase
                        assign is_footer_last_chance = false

                        if footer_link_title contains 'last chance' or footer_link_url contains 'last-chance'
                          assign is_footer_last_chance = true
                        endif
                      -%}

                      <li>
                        <a href="{{ link.url }}" class="link-faded{% if is_footer_last_chance %} footer__last-chance-link{% endif %}">
                          {%- if is_footer_last_chance -%}
                            <span class="footer__last-chance-dot" aria-hidden="true"></span>
                          {%- endif -%}
                          <span>{{ link.title }}</span>
                        </a>
                      </li>

                    {%- endfor -%}

                  </ul>

                {%- endcapture -%}

                <div class="v-stack gap-4 sm:gap-5

                {% if block.settings.collapse_on_mobile %}
                  sm-max:hidden

                {% endif %}
                ">

                {%- if block.settings.show_menu_title != blank -%}

                  <p class="h6">
                  {{ menu_title }}

                  </p>

                {%- endif -%}
                {{- menu_content -}}

              </div>

              {%- if block.settings.collapse_on_mobile -%}
                {%- render 'accordion', title: menu_title, content: menu_content, class: 'sm:hidden' -%}

              {%- endif -%}

            {%- endif -%}

          {%- when 'newsletter' -%}

            <div class="v-stack gap-4 sm:gap-5">

              {%- if block.settings.title != blank -%}

                <p class="h6">
                {{ block.settings.title }}

                </p>

              {%- endif -%}

              {%- if block.settings.content != blank -%}

                <div class="prose text-subdued">
                  {{- block.settings.content -}}

                </div>

              {%- endif -%}
              {%- assign newsletter_form_id = 'newsletter-form-' | append: section.id -%}

              {%- form 'customer', id: newsletter_form_id, class: 'form' -%}

                {%- if form.posted_successfully? -%}
                  {%- assign success_message = 'general.newsletter.subscribed_successfully' | t -%}
                  {%- render 'banner', content: success_message, status: 'success' -%}

                {%- else -%}

                  {%- if form.errors -%}

                    {%- capture error_message -%}
                      {{ form.errors.translated_fields['email'] }} {{ form.errors.messages['email'] }}

                    {%- endcapture -%}
                    {%- render 'banner', content: error_message, status: 'error' -%}

                  {%- endif -%}

                  <input type="hidden" name="contact[tags]" value="newsletter">
                  {%- assign input_label = 'general.newsletter.email' | t -%}
                  {%- render 'input', name: 'contact[email]', label: input_label, type: 'email', required: true, autocomplete: 'email', enterkeyhint: 'send' -%}

                  <div class="align-self-start">
                    {%- assign button_label = 'general.newsletter.subscribe' | t -%}
                    {%- render 'button', type: 'submit', content: button_label, background: block.settings.button_background, text_color: block.settings.button_text_color -%}

                  </div>

                {%- endif -%}

              {%- endform -%}

            </div>

          {%- endcase -%}

        {%- endcapture -%}

        {%- if block_content != blank -%}

          {%- capture current_block -%}

            <div class="footer__block footer__block--{{ block.type | remove_first: '@' }}" {{ block.shopify_attributes }}>
              {{- block_content -}}

            </div>

          {%- endcapture -%}

          {%- if section.settings.enable_custom_columns -%}
            {%- assign target_column = block.settings.footer_column | default: '1' -%}

            {%- case target_column -%}

            {%- when '2' -%}
              {%- assign footer_column_2 = footer_column_2 | append: current_block -%}

            {%- when '3' -%}
              {%- assign footer_column_3 = footer_column_3 | append: current_block -%}

            {%- when '4' -%}
              {%- assign footer_column_4 = footer_column_4 | append: current_block -%}

            {%- when '5' -%}
              {%- assign footer_column_5 = footer_column_5 | append: current_block -%}

            {%- when '6' -%}
              {%- assign footer_column_6 = footer_column_6 | append: current_block -%}

            {%- else -%}
              {%- assign footer_column_1 = footer_column_1 | append: current_block -%}

            {%- endcase -%}

          {%- else -%}
            {%- liquid
            assign collapse_block = false
            if block.type == 'links' and block.settings.collapse_on_mobile
            assign collapse_block = true
            endif
            -%}

            {%- if collapse_block -%}
              {%- assign accordion_group_content = accordion_group_content | append: current_block -%}

            {%- else -%}

              {%- if accordion_group_content != blank -%}

                <div class="footer__accordion-group accordion-group">
                  {{- accordion_group_content -}}

                </div>
                {%- assign accordion_group_content = '' -%}

              {%- endif -%}
              {{- current_block -}}

            {%- endif -%}

          {%- endif -%}

        {%- endif -%}

      {%- endfor -%}

      {%- unless section.settings.enable_custom_columns -%}

        {%- if accordion_group_content != blank -%}

          <div class="footer__accordion-group accordion-group">
            {{- accordion_group_content -}}

          </div>

        {%- endif -%}

      {%- endunless -%}

    {%- endcapture -%}

    {%- if section.settings.enable_custom_columns -%}

      <div class="footer__block-list footer__block-list--custom-columns">

        {%- if footer_column_1 != blank -%}

          <div class="footer__custom-column">
            {{- footer_column_1 -}}

          </div>

        {%- endif -%}

        {%- if footer_column_2 != blank -%}

          <div class="footer__custom-column">
            {{- footer_column_2 -}}

          </div>

        {%- endif -%}

        {%- if footer_column_3 != blank -%}

          <div class="footer__custom-column">
            {{- footer_column_3 -}}

          </div>

        {%- endif -%}

        {%- if footer_column_4 != blank -%}

          <div class="footer__custom-column">
            {{- footer_column_4 -}}

          </div>

        {%- endif -%}

        {%- if footer_column_5 != blank -%}

          <div class="footer__custom-column">
            {{- footer_column_5 -}}

          </div>

        {%- endif -%}

        {%- if footer_column_6 != blank -%}

          <div class="footer__custom-column">
            {{- footer_column_6 -}}

          </div>

        {%- endif -%}

      </div>

    {%- else -%}

      <div class="footer__block-list">
        {{- standard_footer_blocks -}}

      </div>

    {%- endif -%}

  {%- endif -%}
  {%- comment -%}
  ------------------------------------------------------------------------------------------------------------------
  FOOTER SOCIAL MEDIA
  ------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  {%- if section.settings.show_social_media -%}
    {%- render 'social-media', layout: 'list' -%}

  {%- endif -%}
  {%- comment -%}
  ------------------------------------------------------------------------------------------------------------------
  FOOTER ASIDE (COPYRIGHT + LOCALIZATION SELECTORS + PAYMENT METHODS)
  ------------------------------------------------------------------------------------------------------------------
  {%- endcomment -%}

  <div class="footer__aside">

    {%- if section.settings.show_country_selector and localization.available_countries.size > 1 -%}
      {%- assign show_country_selector = true -%}

    {%- endif -%}

    {%- if section.settings.show_locale_selector and localization.available_languages.size > 1 -%}
      {%- assign show_locale_selector = true -%}

    {%- endif -%}

    {%- if show_country_selector or show_locale_selector -%}

      <div class="localization-selectors">

        {%- if show_country_selector -%}
          {%- render 'localization-selector',
          type: 'country',
          placement: 'top-start',
          show_country_name: section.settings.show_country_name,
          show_country_flag: section.settings.show_country_flag
          -%}

        {%- endif -%}

        {%- if show_locale_selector -%}
          {%- render 'localization-selector', type: 'locale', placement: 'top-start' -%}

        {%- endif -%}

      </div>

    {%- endif -%}

    <p class="heading text-subdued text-xxs">
    © {{ 'now' | date: '%Y' }} - {{ shop.name }}

    {%- if section.settings.custom_footer_credit != blank -%}
      <span>
      ·

      {%- if section.settings.custom_footer_credit_link != blank -%}
        <a href="{{ section.settings.custom_footer_credit_link }}">
        {{ section.settings.custom_footer_credit }}
        </a>

      {%- else -%}
        {{ section.settings.custom_footer_credit }}

      {%- endif -%}
      </span>

    {%- elsif section.settings.show_powered_by_shopify -%}
      {{ powered_by_link }}

    {%- endif -%}

    </p>

    {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}

      <ul class="payment-methods unstyled-list">

        {%- for type in shop.enabled_payment_types -%}

          <li>
            {{- type | payment_type_svg_tag -}}

          </li>

        {%- endfor -%}

      </ul>

    {%- endif -%}

  </div>
</div>
</div>
</div>
{% schema %}
  {
  "name": "t:sections.footer.name",
  "class": "shopify-section--footer",
  "tag": "footer",
  "max_blocks": 20,
  "settings": [
  {
  "type": "color_scheme",
  "id": "color_scheme",
  "label": "t:global.colors.scheme",
  "default": "scheme-2"
  },
  {
  "type": "checkbox",
  "id": "separate_section_with_border",
  "label": "t:global.section.separate_section_with_border",
  "default": false
  },
  {
  "type": "header",
  "content": "Custom footer columns"
  },
  {
  "type": "checkbox",
  "id": "enable_custom_columns",
  "label": "Enable custom footer columns",
  "default": false
  },
  {
  "type": "range",
  "id": "custom_desktop_columns",
  "min": 2,
  "max": 6,
  "step": 1,
  "label": "Desktop columns",
  "default": 5,
  "visible_if": "{{ section.settings.enable_custom_columns }}"
  },
  {
  "type": "range",
  "id": "custom_column_gap",
  "min": 16,
  "max": 100,
  "step": 4,
  "unit": "px",
  "label": "Space between columns",
  "default": 48,
  "visible_if": "{{ section.settings.enable_custom_columns }}"
  },
  {
  "type": "range",
  "id": "custom_item_gap",
  "min": 0,
  "max": 40,
  "step": 2,
  "unit": "px",
  "label": "Space between items in a column",
  "default": 14,
  "visible_if": "{{ section.settings.enable_custom_columns }}"
  },
  {
  "type": "checkbox",
  "id": "show_social_media",
  "label": "t:sections.footer.show_social_media",
  "info": "t:sections.footer.show_social_media_info",
  "default": true
  },
  {
  "type": "checkbox",
  "id": "show_payment_icons",
  "label": "t:sections.footer.show_payment_icons",
  "default": true
  },
  {
  "type": "checkbox",
  "id": "show_powered_by_shopify",
  "label": "t:sections.footer.show_powered_by_shopify",
  "default": true
  },
  {
  "type": "text",
  "id": "custom_footer_credit",
  "label": "Custom footer credit",
  "placeholder": "Designed & Developed by Soft Solutions"
  },
  {
  "type": "url",
  "id": "custom_footer_credit_link",
  "label": "Custom footer credit link"
  },
  {
  "type": "header",
  "content": "t:global.localization.country_region_selector_category",
  "info": "t:global.localization.country_region_selector_category_info"
  },
  {
  "type": "checkbox",
  "id": "show_country_selector",
  "label": "t:global.localization.show_country_region_selector",
  "default": true
  },
  {
  "type": "checkbox",
  "id": "show_country_name",
  "label": "t:global.localization.show_country_name",
  "default": true,
  "visible_if": "{{ section.settings.show_country_selector }}"
  },
  {
  "type": "checkbox",
  "id": "show_country_flag",
  "label": "t:global.localization.show_country_flag",
  "default": true,
  "visible_if": "{{ section.settings.show_country_selector }}"
  },
  {
  "type": "header",
  "content": "t:global.localization.language_selector_category",
